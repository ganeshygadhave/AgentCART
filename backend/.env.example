# ─── AgentCART Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.

# ─── Database ───────────────────────────────────────────────────────────────
# For SQLite (development, zero-config)
DATABASE_URL=sqlite+aiosqlite:///./agentcart.db

# For PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentcart

# ─── Application ────────────────────────────────────────────────────────────
APP_NAME=AgentCART
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Gemini AI ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ─── Razorpay (Test Mode) ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ─── CORS ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
